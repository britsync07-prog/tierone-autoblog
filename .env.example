# ==============================================================================
# TierOne AutoBlog — Environment Variables Reference (.env.example)
# ==============================================================================
# All services follow the OWNER FULLY-FREE DIRECTIVE: zero paid APIs.
# Copy this file to `.env` (gitignored) for local development or VPS backend,
# and set these in your Cloudflare Pages / VPS environment variables.

# ------------------------------------------------------------------------------
# 1. AI Content Generation Engine (Required for Autonomous Writing)
# ------------------------------------------------------------------------------
# Any FREE OpenAI-compatible API endpoint (Groq, OpenRouter, or Ollama).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_free_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_CHEAP=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# 2. Private Dashboard Access (Required for /dashboard Route)
# ------------------------------------------------------------------------------
# Secret token gating access to your private growth dashboard:
# Access URL: https://yourdomain.com/dashboard?token=YOUR_SECRET_TOKEN
DASHBOARD_SECRET=your_secure_random_string_here_32_chars

# ------------------------------------------------------------------------------
# 3. Dual-Track Search Indexing (IndexNow for Bing, Yandex, etc.)
# ------------------------------------------------------------------------------
# Hexadecimal key for IndexNow protocol.
INDEXNOW_KEY=your_indexnow_hex_key_here

# ------------------------------------------------------------------------------
# 4. Google Search Console API (For Google Sitemap & Performance Analytics)
# ------------------------------------------------------------------------------
# Service Account created in Google Cloud Console with delegated Search Console access.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAASCBKYwggSiAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. Operational Alerts (Optional)
# ------------------------------------------------------------------------------
# Discord / Slack / Telegram webhook URL for dead-letter queue or quarantine alerts.
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
