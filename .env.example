# ==============================================================================
# TierOne AutoBlog — Environment Variables Reference (.env)
# ==============================================================================
# All services follow the OWNER FULLY-FREE DIRECTIVE: zero paid APIs.
# Copy this file to `.env` (which is gitignored) for local development,
# and set these in your Vercel Project Settings for production.

# ------------------------------------------------------------------------------
# 1. AI Content Generation Engine (Required for Autonomous Writing)
# ------------------------------------------------------------------------------
# Any FREE OpenAI-compatible API endpoint.
# Recommended Options:
#   A) Groq (Fast & Free): https://console.groq.com/keys
#   B) OpenRouter (Free models): https://openrouter.ai/keys (use :free models)
#   C) Local Ollama: http://localhost:11434/v1 (leave LLM_API_KEY blank)

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_free_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Optional cheaper/faster model for narrow tasks (summarize, title, meta desc).
# If unset, LLM_MODEL is used for all tasks.
LLM_MODEL_CHEAP=llama-3.1-8b-instant

# Optional fallback provider (free tier only)
# LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# LLM_FALLBACK_API_KEY=sk-or-your-free-key
# LLM_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# 2. Private Dashboard Access (Required for /dashboard Route)
# ------------------------------------------------------------------------------
# Secret token gating access to your private growth dashboard:
# Access URL: https://yourdomain.com/dashboard?token=YOUR_SECRET_TOKEN
# Make this a long, random string (e.g. 32+ characters).
DASHBOARD_SECRET=generate_a_secure_random_string_here_32_chars_or_more

# ------------------------------------------------------------------------------
# 3. Dual-Track Search Indexing (IndexNow for Bing, Yandex, etc.)
# ------------------------------------------------------------------------------
# Hexadecimal or alphanumeric key (8-128 chars) for IndexNow protocol.
# Generate one in Bing Webmaster Tools or use a random UUID/hex string.
INDEXNOW_KEY=generate_an_indexnow_hex_key_here

# ------------------------------------------------------------------------------
# 4. Google Search Console API (For Google Sitemap & Performance Analytics)
# ------------------------------------------------------------------------------
# Service Account created in Google Cloud Console with delegated Search Console access.
# If unset, the dashboard and indexing gracefully fall back to offline snapshots.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. Plausible Analytics (Optional: For Country-Level Engagement Stats)
# ------------------------------------------------------------------------------
# API key from Plausible Cloud or self-hosted Plausible Community Edition.
# If unset, the dashboard falls back to cached snapshot or synthetic demo data.
PLAUSIBLE_API_KEY=your_plausible_stats_api_key

# ------------------------------------------------------------------------------
# 6. Operational Alerts (Optional)
# ------------------------------------------------------------------------------
# Discord / Slack / Telegram webhook URL for dead-letter queue or quarantine alerts.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
