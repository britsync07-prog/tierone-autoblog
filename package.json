    "pipeline:resume": "node scripts/pipeline-resume.mjs",
    "publish:scheduled": "tsx scripts/publish-scheduled.ts",
    "verify:live": "tsx scripts/verify-live-url.ts",
    "test:eval": "tsx --test tests/eval-20.test.ts",
    "eval:run": "tsx scripts/run-eval-suite.ts",
    "refresh:run": "tsx scripts/run-content-refresh.ts",
    "post:retire": "tsx scripts/retire-post.ts",
    "silos:check": "tsx scripts/check-pillar-clusters.ts",
    "indexnow:sync": "node -r dotenv/config scripts/sync-indexnow-key.mjs"
  },
  "dependencies": {
