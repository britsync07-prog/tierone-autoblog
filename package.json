    "@tailwindcss/typography": "^0.5.20",
    "@vercel/og": "^1.0.3",
    "github-slugger": "^2.0.0",
    "googleapis": "^186.0.0",
    "gray-matter": "^4.0.3",
    "next": "^16.4.2",
    "next-seo": "^7.3.0",
    "openai": "^7.36.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "zod": "^4.6.7"
