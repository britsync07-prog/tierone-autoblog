{
  "name": "tierone-autoblog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/**/*.test.ts",
    "check:seeds": "node scripts/check-seeds.mjs",
    "check:crawl": "node scripts/check-crawl.mjs",
    "pipeline": "tsx lib/pipeline/run.ts",
    "pipeline:expand": "tsx lib/pipeline/run.ts --stage expand",
    "pipeline:brief": "tsx lib/pipeline/run.ts --stage brief",
    "pipeline:outline": "tsx lib/pipeline/run.ts --stage outline",
    "pipeline:assets": "tsx lib/pipeline/run.ts --stage assets",
    "pipeline:draft": "tsx lib/pipeline/run.ts --stage draft",
    "pipeline:qa": "tsx lib/pipeline/run.ts --stage qa",
    "check:registry": "node scripts/check-registry.mjs",
    "check:outline": "node scripts/check-outline.mjs",
    "check:template": "node scripts/check-template.mjs",
    "quarantine:list": "node scripts/quarantine-list.mjs",
